VOICE_TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_URL=http://127.0.0.1:8765/transcribe
LOCAL_WHISPER_TIMEOUT_MS=60000
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_CPU_THREADS=12
OPENAI_TRANSCRIPTION_LANGUAGE=zh
OPENAI_TRANSCRIPTION_PROMPT=这是一款名为 Lumi 的中文手势舞教学助手。常用词和口令包括：Lumi，准备，第一拍，第二拍，收势，显示骨架，关闭骨架，暂停，继续，慢一点，快一点，上一个动作，下一个动作，再来一遍，从头开始，开始评估，回到主界面，重新练习。
